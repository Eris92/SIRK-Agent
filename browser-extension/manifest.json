{
  "manifest_version": 3,
  "name": "SIRK Browser Bridge",
  "version": "1.0.0",
  "key": "",
  "description": "Policy-controlled browser activity bridge for SIRK Agent.",
  "permissions": ["tabs", "downloads", "nativeMessaging", "webNavigation", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
